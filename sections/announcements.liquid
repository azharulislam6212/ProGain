


 <div  style="max-width: 318.75px; overflow: hidden;">

 
 {%- assign section_settings = section.settings -%}

 <motion-effect data-motion="{{  settings.motion_effect | default: 'zoom-out' }}" class="block h-full">

     {% render 'responsive-media',
     image: section_settings.image,
     image_ratio: section_settings.image_ratio,
     mobile_widths: '320,380,570',
     desktop_widths: '570,750,900,1100,1400',
     mobile_sizes: '(max-width: 767px) 50vw',
     desktop_sizes: '(min-width: 768px) 100vw',
     alt_text: section_settings.alt_text,
     is_hero: true
  %}

</motion-effect>




 

</div>


{% schema %}
{
  "name": "Announcements",
  "tag": "section",
  "class": "section",
  "settings": [

  {
			"type": "image_picker",
			"id": "image",
			"label": "t:options.image"
		},
        
        {
      "type": "text",
      "id": "alt_text",
      "label": "Alt Text"
    },

         {
        "type": "select",
        "id": "motion_effect",
        "label": "Motion effect",
        "options": [
          {
            "value": "",
            "label": "None"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "zoom-in",
            "label": "Zoom In"
          },
          {
            "value": "zoom-out",
            "label": "Zoom Out"
          },
          {
            "value": "blur",
            "label": "Blur"
          },
          {
            "value": "reveal",
            "label": "Reveal"
          }
        ],
        "default": "fade"
      },
		{
			"type": "select",
			"id": "image_ratio",
			"default": "3/4",
			"label": "t:options.aspect_ratio",
			"options": [
				{
					"value": "1/1",
					"label": "t:options.square"
				},
      	{
					"value": "4/5",
					"label": "t:options.portrait_4_5"
				},
      	{
					"value": "3/4",
					"label": "t:options.portrait_3_4"
				},
				{
					"value": "4/3",
					"label": "t:options.landscape_4_3"
				},
				{
					"value": "16/9",
					"label": "t:options.landscape_16_9"
				},
				{
					"value": "21/9",
					"label": "t:options.landscape_21_9"
				},
				{
					"value": "auto",
					"label": "t:options.auto"
				}
			]
		},
  ]
}
{% endschema %}
