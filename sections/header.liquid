{%- render 'icon', icon: 'chevron-left', size: settings.icon_size -%}
{%- render 'icon', icon: 'spinner', size: settings.icon_size -%}

{% render 'button',
  tag: 'a',
  button_label: section.settings.button_label,
  button_link: section.settings.button_link,
  button_style: section.settings.button_style,
  button_size: section.settings.button_size,
  button_icon: section.settings.button_icon,
  icon_only: section.settings.icon_only,
  icon_style: section.settings.icon_style,
  icon_align: section.settings.icon_align,
  plain_icon_align: section.settings.plain_icon_align,
  loader: true
%}


{% render 'button',
  tag: 'a',
  button_label: section.settings.button_label,
  button_link: section.settings.button_link,
  button_style: section.settings.button_style,
  button_size: section.settings.button_size,
  button_icon: section.settings.button_icon,
  icon_only: section.settings.icon_only,
  icon_style: section.settings.icon_style,
  icon_align: section.settings.icon_align,
  plain_icon_align: section.settings.plain_icon_align
%}

<span class="badge badge--new">New</span>
<span class="badge badge--sale">Sale</span>
<span class="badge badge--sold-out">Sold out</span>




<div class="page-width">



<div  style="max-width: 418.75px; overflow: hidden;">

 
 {%- assign section_settings = section.settings -%}

 <motion-effect data-motion="{{ settings.motion_effect | default: 'zoom-out' }}" class="block h-full">

     {% render 'responsive-media',
     image: section_settings.image,
     mobile_image: section_settings.mobile_image,
     image_ratio: section_settings.image_ratio,
     image_ratio_mobile: section_settings.image_ratio_mobile,
     mobile_widths: '320,380,570',
     desktop_widths: '570,750,900,1100,1400',
     mobile_sizes: '(max-width: 767px) 50vw',
     desktop_sizes: '(min-width: 768px) 100vw',
     alt_text: section_settings.alt_text,
     is_hero: true
  %}

</motion-effect>




 

</div>





 	<div class="imager-wrapper" style="  display:flex; gap: 30px;" >
{% for i in (1..5) %}
    
        {% assign slideshow_index = forloop.index | modulo: 3 | plus: 1 %} 

        <div class="media relative">
	        {{ 'hero-apparel-' | append: slideshow_index | placeholder_svg_tag: 'placeholder' }} 
        </div>
		
							 
{%- endfor -%}
</div>


<input type="text" class="form-control" placeholder="Email address">

<div class="select">
  <label for="ContactForm-select-country" class="visually-hidden"> Country </label>

  <select
    id="ContactForm-select-country"
    name="contact[Country]"
    class="form-control form-control--select"
    aria-label="Country"
  >
    <option value="Austria">Austria</option>
    <option value="Viet Nam">Viet Nam</option>
    <option value="Japan">Japan</option>
  </select>
</div>

<div class="hero-banner height--medium ">banner</div>

<motion-effect
  data-motion="split-text"
  data-motion-delay="200"
  data-motion-duration="1.2"
  data-motion-ease="power4.out"
>
  <h2>Premium Theme</h2>
</motion-effect>


{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section",
  "settings": [
  	{
			"type": "header",
			"content": "t:content.image"
		},
 	{
			"type": "image_picker",
			"id": "image",
			"label": "t:options.image"
		},
        {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (optional)"
    },
        {
      "type": "text",
      "id": "alt_text",
      "label": "Alt Text"
    },
		{
			"type": "select",
			"id": "image_ratio",
			"default": "3/4",
			"label": "t:options.aspect_ratio",
			"options": [
				{
					"value": "1/1",
					"label": "t:options.square"
				},
      	{
					"value": "4/5",
					"label": "t:options.portrait_4_5"
				},
      	{
					"value": "3/4",
					"label": "t:options.portrait_3_4"
				},
				{
					"value": "4/3",
					"label": "t:options.landscape_4_3"
				},
				{
					"value": "16/9",
					"label": "t:options.landscape_16_9"
				},
				{
					"value": "21/9",
					"label": "t:options.landscape_21_9"
				},
				{
					"value": "auto",
					"label": "t:options.auto"
				}
			]
		},
    		{
			"type": "select",
			"id": "image_ratio_mobile",
			"default": "3/4",
			"label": "t:options.aspect_ratio",
			"options": [
				{
					"value": "1/1",
					"label": "t:options.square"
				},
      	{
					"value": "4/5",
					"label": "t:options.portrait_4_5"
				},
      	{
					"value": "3/4",
					"label": "t:options.portrait_3_4"
				},
				{
					"value": "4/3",
					"label": "t:options.landscape_4_3"
				},
				{
					"value": "16/9",
					"label": "t:options.landscape_16_9"
				},
				{
					"value": "21/9",
					"label": "t:options.landscape_21_9"
				},
				{
					"value": "auto",
					"label": "t:options.auto"
				}
			]
		},
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "primary-outline",
          "label": "Primary outline"
        },
        {
          "value": "secondary-outline",
          "label": "Secondary outline"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Size",
      "options": [
        {
          "value": "extra-small",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "button_icon",
      "label": "Icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "arrow-right",
          "label": "Arrow"
        },
        {
          "value": "long-arrow-right",
          "label": "Long Arrow"
        },
        {
          "value": "arrow-in-cricle-right",
          "label": "Arrow in cricle"
        },
        {
          "value": "chevron-right",
          "label": "Chevron"
        },
        {
          "value": "double-chevron-right",
          "label": "Double chevron"
        },
        {
          "value": "flow-arrow-right",
          "label": "Flow arrow"
        },
        {
          "value": "diagonal-arrow",
          "label": "Diagonal"
        },
        {
          "value": "close",
          "label": "Close"
        }
      ],
      "default": "diagonal-arrow"
    },

    {
      "type": "checkbox",
      "id": "icon_only",
      "label": "Icon only",
      "default": false,
      "visible_if": "{{ section.settings.button_icon != 'none' and section.settings.button_style != 'plain'}}"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon style",
      "options": [
        {
          "value": "default",
          "label": "default"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.button_icon != 'none' and section.settings.button_style != 'plain'}}"
    },
    {
      "type": "select",
      "id": "icon_align",
      "label": "Icon align",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.button_style != 'plain' and section.settings.icon_only == false  }}"
    },
    {
      "type": "select",
      "id": "plain_icon_align",
      "label": "Icon align",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.button_icon != 'none' and section.settings.button_style == 'plain' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_gradient",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
