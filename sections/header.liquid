{%- assign section_settings = section.settings -%}
<div class="section  bg-secondary color-{{ section_settings.color_scheme }} rte">
  <div class="page-width">
    <h2>Heading This is animated text!</h2>
    <a href="" class="h2 reversed-link">
      <span class="reversed-link__text"> Scroll me </span>
    </a>
    <h2 class="animate-split">SplitText Animation</h2>
    Lorem ipsum dolor sit amet consectetur, adipisicing elit. <a href="">Voluptatum</a> magni omnis doloremque deleniti,
    delectus tenetur quas est perferendis eum iure sequi, id necessitatibus, hic dignissimos iusto impedit nemo dolorum?
    Aspernatur?

    <p class="animate-text color-gradient color-{{ section_settings.color_scheme_gradient }}">dfsdf sdfsdfsdf</p>
  </div>
</div>

{%- render 'icon', icon: 'chevron-left', size: settings.icon_size -%}
{%- render 'icon', icon: 'spinner', size: settings.icon_size -%}

{% render 'button',
  tag: 'a',
  button_label: section.settings.button_label,
  button_link: section.settings.button_link,
  button_style: section.settings.button_style,
  button_size: section.settings.button_size,
  button_icon: section.settings.button_icon,
  icon_only: section.settings.icon_only,
  icon_style: section.settings.icon_style,
  icon_align: section.settings.icon_align,
  plain_icon_align: section.settings.plain_icon_align,
  loader: true
%}


{% render 'button',
  tag: 'a',
  button_label: section.settings.button_label,
  button_link: section.settings.button_link,
  button_style: section.settings.button_style,
  button_size: section.settings.button_size,
  button_icon: section.settings.button_icon,
  icon_only: section.settings.icon_only,
  icon_style: section.settings.icon_style,
  icon_align: section.settings.icon_align,
  plain_icon_align: section.settings.plain_icon_align
%}

<span class="badge badge--new">New</span>
<span class="badge badge--sale">Sale</span>
<span class="badge badge--sold-out">Sold out</span>




 	<div class="imager-wrapper" style="  display:flex; gap: 30px;" >
{% for i in (1..5) %}
    
        {% assign slideshow_index = forloop.index | modulo: 3 | plus: 1 %} 
			{{ 'hero-apparel-' | append: slideshow_index | placeholder_svg_tag: 'placeholder-svg' }} 
    
							 
{%- endfor -%}
</div>


<input type="text" class="form-control" placeholder="Email address">

<div class="select">
  <label for="ContactForm-select-country" class="visually-hidden"> Country </label>

  <select
    id="ContactForm-select-country"
    name="contact[Country]"
    class="form-control form-control--select"
    aria-label="Country"
  >
    <option value="Austria">Austria</option>
    <option value="Viet Nam">Viet Nam</option>
    <option value="Japan">Japan</option>
  </select>
</div>

<div class="hero-banner height--medium ">banner</div>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "primary-outline",
          "label": "Primary outline"
        },
        {
          "value": "secondary-outline",
          "label": "Secondary outline"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Size",
      "options": [
        {
          "value": "extra-small",
          "label": "Extra small"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "button_icon",
      "label": "Icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "arrow-right",
          "label": "Arrow"
        },
        {
          "value": "long-arrow-right",
          "label": "Long Arrow"
        },
        {
          "value": "arrow-in-cricle-right",
          "label": "Arrow in cricle"
        },
        {
          "value": "chevron-right",
          "label": "Chevron"
        },
        {
          "value": "double-chevron-right",
          "label": "Double chevron"
        },
        {
          "value": "flow-arrow-right",
          "label": "Flow arrow"
        },
        {
          "value": "diagonal-arrow",
          "label": "Diagonal"
        },
        {
          "value": "close",
          "label": "Close"
        }
      ],
      "default": "diagonal-arrow"
    },

    {
      "type": "checkbox",
      "id": "icon_only",
      "label": "Icon only",
      "default": false,
      "visible_if": "{{ section.settings.button_icon != 'none' and section.settings.button_style != 'plain'}}"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon style",
      "options": [
        {
          "value": "default",
          "label": "default"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.button_icon != 'none' and section.settings.button_style != 'plain'}}"
    },
    {
      "type": "select",
      "id": "icon_align",
      "label": "Icon align",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.button_style != 'plain' and section.settings.icon_only == false  }}"
    },
    {
      "type": "select",
      "id": "plain_icon_align",
      "label": "Icon align",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.button_icon != 'none' and section.settings.button_style == 'plain' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_gradient",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
