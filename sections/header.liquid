      <span class="reversed-link__text"> Scroll me </span>
    </a>

      <a href="/pages/faq" class="h2 reversed-link" data-spa-link>
      <span class="reversed-link__text"> Faqs </span>
    </a>
    <h2 class="animate-split">SplitText Animation</h2>
