{% render 'button',
  tag: 'a',
  button_label: section.settings.button_label,
  button_link: section.settings.button_link,
  button_style: section.settings.button_style,
  button_size: section.settings.button_size,
  button_icon: section.settings.button_icon,
  icon_only: section.settings.icon_only,
  icon_style: section.settings.icon_style,
  icon_align: section.settings.icon_align
%}


 
 
<input type="text" class="form-control" placeholder="Email address">
 


<div class="select">
  <label for="ContactForm-select-country" class="visually-hidden">
    Country
  </label>

  <select
    id="ContactForm-select-country"
    name="contact[Country]"
    class="form-control form-control--select"
    aria-label="Country"
  >
    <option value="Austria">Austria</option>
    <option value="Viet Nam">Viet Nam</option>
    <option value="Japan">Japan</option>
  </select>
</div>


<div class="hero-banner height--medium ">banner</div>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Button label"
      },
   {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      },

      {
        "type": "select",
        "id": "button_style",
        "label": "Style",
        "options": [
          {
            "value": "primary",
            "label": "Primary"
          },
          {
            "value": "secondary",
            "label": "Secondary"
          },
          {
            "value": "primary-outline",
            "label": "Primary outline"
          },
            {
            "value": "secondary-outline",
            "label": "Secondary outline"
          },
          {
            "value": "link",
            "label": "Plain"
          }
        ],
        "default": "primary"
      },
      {
        "type": "select",
        "id": "button_size",
        "label": "Size",
        "options": [
          {
            "value": "extra-small",
            "label": "Extra small"
          },
          {
            "value": "small",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "large",
            "label": "large"
          }
        ],
        "default": "large"
      },
      {
        "type": "select",
        "id": "button_icon",
        "label": "Icon",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "caret",
            "label": "Caret"
          },
          {
            "value": "arrow",
            "label": "Arrow"
          },
          {
            "value": "long-arrow",
            "label": "Long Arrow"
          },
          {
            "value": "double-arrow",
            "label": "Double arrow"
          },
          {
            "value": "chevron-arrow",
            "label": "Chevron arrow"
          },
          {
            "value": "diagonal-arrow",
            "label": "Diagonal arrow"
          }
        ],
        "default": "caret"
      },
      
      {
        "type": "checkbox",
        "id": "icon_only",
        "label": "Icon only",
        "default": false,
         "visible_if": "{{ section.settings.button_icon != 'none'}}"
      },
        {
        "type": "select",
        "id": "icon_style",
        "label": "Icon style",
        "options": [
          {
            "value": "",
            "label": "default"
          },
          {
            "value": "solid",
            "label": "Solid"
          }
        ],
        "default": "solid",
         "visible_if": "{{ section.settings.button_icon != 'none'}}"
      },
      {
        "type": "select",
        "id": "icon_align",
        "label": "Icon align",
        "options": [
          {
            "value": "start",
            "label": "Start"
          },
          {
            "value": "end",
            "label": "End"
          }
        ],
        "default": "start",
              "visible_if": "{{ section.settings.button_icon != 'none'}}"
   
      },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_gradient",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
