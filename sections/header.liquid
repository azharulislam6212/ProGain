{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section",
  "settings": [
      {
        "type": "select",
        "id": "primary_button_style",
        "label": "Style",
        "options": [
          {
            "value": "primary",
            "label": "Primary"
          },
          {
            "value": "secondary",
            "label": "Secondary"
          },
          {
            "value": "primary-outline",
            "label": "Primary outline"
          },
            {
            "value": "secondary-outline",
            "label": "Secondary outline"
          },
          {
            "value": "link",
            "label": "Plain"
          }
        ],
        "default": "primary"
      },
      {
        "type": "select",
        "id": "primary_button_size",
        "label": "Size",
        "options": [
          {
            "value": "extra_small",
            "label": "Extra small"
          },
          {
            "value": "samll",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "large",
            "label": "large"
          }
        ],
        "default": "large"
      },
      {
        "type": "select",
        "id": "primary_button_icon",
        "label": "Icon",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "arrow",
            "label": "Arrow"
          },
          {
            "value": "long-arrow",
            "label": "Long Arrow"
          },
          {
            "value": "double-arrow",
            "label": "Double arrow"
          },
          {
            "value": "chevron-arrow",
            "label": "Chevron arrow"
          },
          {
            "value": "diagonal-arrow",
            "label": "Diagonal arrow"
          }
        ],
        "default": "none"
      },
      
      {
        "type": "checkbox",
        "id": "primary_icon_only",
        "label": "Icon only",
        "default": false,
         "visible_if": "{{ section.settings.primary_button_icon != 'none'}}"
      },
        {
        "type": "select",
        "id": "primary_icon_style",
        "label": "Icon style",
        "options": [
          {
            "value": "",
            "label": "default"
          },
          {
            "value": "solid",
            "label": "Solid"
          }
        ],
        "default": "solid",
         "visible_if": "{{ section.settings.primary_button_icon != 'none'}}"
      },
      {
        "type": "select",
        "id": "primary_icon_position",
        "label": "Icon position",
        "options": [
          {
            "value": "start",
            "label": "Start"
          },
          {
            "value": "end",
            "label": "End"
          }
        ],
        "default": "start",
              "visible_if": "{{ section.settings.primary_button_icon != 'none'}}"
   
      },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_gradient",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
