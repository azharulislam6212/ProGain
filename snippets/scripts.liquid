<!-- Importmap: module paths mapping -->
<script type="importmap">
  {
    "imports": {
      "@theme/shadow-component": "{{ 'shadow-component.js' | asset_url }}",
      "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
      "@theme/modules": "{{ 'modules.js' | asset_url }}",
      "@theme/component": "{{ 'component.js' | asset_url }}",
      "@theme/events": "{{ 'events.js' | asset_url }}",
      "@theme/dialog": "{{ 'dialog.js' | asset_url }}",

      "@theme/scrollbar": "{{ 'scrollbar.js' | asset_url }}",
      "@theme/swiper": "{{ 'swiper.js' | asset_url }}",
      "@theme/lenis": "{{ 'lenis.js' | asset_url }}",
      "@theme/gsap": "{{ 'gsap.js' | asset_url }}",
      "@theme/ScrollTrigger": "{{ 'ScrollTrigger.js' | asset_url }}",
      "@theme/SplitText": "{{ 'SplitText.js' | asset_url }}",
      "@theme/TextPlugin": "{{ 'TextPlugin.js' | asset_url }}",
      "@theme/morph": "{{ 'morph.js' | asset_url }}",
      "@theme/motion-engine": "{{ 'motion-engine.js' | asset_url }}",
      "@theme/motion-component": "{{ 'motion-component.js' | asset_url }}",

      
      "@theme/product-form": "{{ 'product-form.js' | asset_url }}",
      "@theme/cart-drawer": "{{ 'cart-drawer.js' | asset_url }}",
      "@theme/custom-elements": "{{ 'custom-elements.js' | asset_url }}",
      "@theme/media-coordinator": "{{ 'media-coordinator.js' | asset_url }}"

    }
  }
</script>

<link rel="modulepreload" href="{{ 'modules.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'utilities.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'events.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'component.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'scrollbar.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'swiper.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'morph.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'motion-engine.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'motion-component.js' | asset_url }}" fetchpriority="low">


<link rel="modulepreload" href="{{ 'custom-elements.js' | asset_url }}" fetchpriority="low">
<link rel="modulepreload" href="{{ 'media-coordinator.js' | asset_url }}" fetchpriority="low">


<script>
window.__THEME__ = {
  translations: {
    placeholder_image: `{{ 'content.placeholder_image' | t }}`,
    added: `{{ 'actions.added' | t }}`,
    recipient_form_fields_visible: `{{ 'content.recipient_form_fields_visible' | t }}`,
    recipient_form_fields_hidden: `{{ 'content.recipient_form_fields_hidden' | t }}`,
    recipient_form_error: `{{ 'content.recipient_form_error' | t }}`,
    items_added_to_cart_one: `{{ 'content.items_added_to_cart.one' | t }}`,
    items_added_to_cart_other: `{{ 'content.items_added_to_cart.other' | t }}`,
  },
  routes: {
    cart_add_url: '{{ routes.cart_add_url | append: ".js" }}',
    cart_change_url: '{{ routes.cart_change_url }}',
    cart_update_url: '{{ routes.cart_update_url }}',
    cart_url: '{{ routes.cart_url }}',
    predictive_search_url: '{{ routes.predictive_search_url }}',
    search_url: '{{ routes.search_url }}',
  },
  template: { name: '{{ template }}' },
  cartType: {{ settings.cart_type | json }},
  settings: {
      pageTransitionsEnabled: true,
      smoothScroll: true,
    },
  moneyFormat: '${{amount}}',
}
</script>

 
<!-- Theme.js module -->
 <script type="module" src="{{ 'custom-elements.js' | asset_url }}"></script>
<script type="module" src="{{ 'theme.js' | asset_url }}"></script>


