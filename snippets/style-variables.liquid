    --color-success: rgb({{ settings.success_color.rgba }});
    --color-white: rgb({{ settings.white_color.rgba }});
    --color-white-rgb: {{ settings.white_color.rgb }};
    --color-black: rgb({{ settings.black_color.rgba }});
    --color-info: rgb({{ settings.info_color.rgba }});
    --color-instock: rgb({{ settings.instock_color.rgba }});
    --color-lowstock: rgb({{ settings.lowstock_color.rgba }});
    --color-outofstock: rgb({{ settings.outofstock_color.rgba }});

    --color-cart-bubble-background: rgb({{ settings.cart_bubble_background.rgba }});
