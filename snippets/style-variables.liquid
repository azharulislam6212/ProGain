    --color-selected-variant-text: rgb({{ settings.selected_variant_text_color.rgba }});
    --color-selected-variant-border: rgb({{ settings.selected_variant_border_color.rgba }});
    --color-selected-variant-hover-background: rgb({{ settings.selected_variant_hover_background_color.rgba }});
    --color-selected-variant-hover-text: rgb({{ settings.selected_variant_hover_text_color.rgba }});
    --color-selected-variant-hover-border: rgb({{ settings.selected_variant_hover_border_color.rgba }});

    --color-swatches-border: rgb({{ settings.swatches_border.rgba }});
    --color-swatches-active-border: rgb({{ settings.swatches_active_border.rgba }});

    --color-new-badge-background: rgb({{ settings.new_badge_background.rgba }});
    --color-new-badge-text: rgb({{ settings.new_badge_text_color.rgba }});
    --color-hot-badge-background: rgb({{ settings.hot_badge_background.rgba }});
    --color-hot-badge-text: rgb({{ settings.hot_badge_text_color.rgba }});
    --color-popular-badge-background: rgb({{ settings.popular_badge_background.rgba }});
    --color-popular-badge-text: rgb({{ settings.popular_badge_text_color.rgba }});
    --color-sale-badge-background: rgb({{ settings.sale_badge_background.rgba }});
    --color-sale-badge-text: rgb({{ settings.sale_badge_text_color.rgba }});
    --color-sold-out-badge-background: rgb({{ settings.sold_out_badge_background.rgba }});
    --color-sold-out-badge-text: rgb({{ settings.sold_out_badge_text_color.rgba }});
    --color-preorder-badge-background: rgb({{ settings.preorder_badge_background.rgba }});
    --color-preorder-badge-text: rgb({{ settings.preorder_badge_text_color.rgba }});
    --color-custom-badge-background: rgb({{ settings.custom_badge_background.rgba }});
    --color-custom-badge-text: rgb({{ settings.custom_badge_text_color.rgba }});


   /* Section Heights */
    --section-height-xsmall: clamp(300px, 35svh, 400px);
    --section-height-small: clamp(400px, 50svh, 650px);
    --section-height-medium: clamp(500px, 60svh, 720px);
    --section-height-large: clamp(600px, 70svh, 920px);
    --section-height-fit: 100svh;

    /* Heights */
    --height-small: clamp(16rem, 6vw + 2rem, 25.6rem);
    --height-medium: clamp(20rem, 7vw + 3rem, 32rem);
    --height-large: clamp(24rem, 8vw + 4rem, 38.4rem);
    --height-full: 100svh;


    /* Hardcoded font sizes */
    --font-size--3xs: 1.2rem;   /* 12px */
    --font-size--2xs: 1.3rem;   /* 13px */
    --font-size--xs: 1.4rem;    /* 14px */
    --font-size--sm: 1.5rem;    /* 15px */
    --font-size--md: 1.6rem;    /* 16px */
    --font-size--lg: 1.8rem;    /* 18px */
    --font-size--xl: 2rem;      /* 20px */
    --font-size--2xl: 2.4rem;   /* 24px */
    --font-size--3xl: 3.2rem;   /* 32px */
    --font-size--4xl: 4.8rem;   /* 48px */
    --font-size--5xl: 5.6rem;   /* 56px */
    --font-size--6xl: 6.2rem;   /* 62px */
    --font-size--7xl: 7.2rem;   /* 72px */
    --font-size--8xl: 8rem;     /* 80px */


    /* Navigation / Menu Font Sizes & Line-Heights (10px base) */
    --nav-font-sm-size: 1.4rem;
    --nav-font-sm-line-height: calc(1.1 + 0.5 * min(10 / 14));

    --nav-font-md-size: 1.6rem;
    --nav-font-md-line-height: calc(1.1 + 0.5 * min(10 / 16));

    --nav-font-lg-size: 1.8rem;
    --nav-font-lg-line-height: calc(1.1 + 0.5 * min(10 / 18));

    --nav-font-xl-size: 2rem;
    --nav-font-xl-line-height: calc(1.1 + 0.5 * min(10 / 20));

    --nav-font-2xl-size: 2.8rem;
    --nav-font-2xl-line-height: calc(1.1 + 0.5 * min(10 / 28));

    /* Spacing */
    --spacing-0: 0rem;      /* 0px */
    --spacing-1: 0.4rem;    /* 4px */
    --spacing-2: 0.8rem;     /* 8px */
    --spacing-3: 1.2rem;     /* 12px */
    --spacing-4: 1.6rem;     /* 16px */
    --spacing-5: 2rem;       /* 20px */
    --spacing-6: 2.4rem;     /* 24px */
    --spacing-7: 3.2rem;    /* 32px */
    --spacing-8: 4rem;      /* 40px */
    --spacing-9: 4.8rem;    /* 48px */
    --spacing-10: 6.4rem;    /* 64px */
    --spacing-11: 8rem;      /* 80px */
    --spacing-12: 9.6rem;    /* 96px */
    --spacing-13: 10rem;     /* 100px */
    --spacing-14: 12.8rem;   /* 128px */
    --spacing-15: 16rem;     /* 160px */

    --scroll-margin: var(--spacing-4);

    /* Opacity */
    --opacity-5: 0.05;
    --opacity-8: 0.08;
    --opacity-10: 0.1;
    --opacity-15: 0.15;
    --opacity-20: 0.2;
    --opacity-25: 0.25;
    --opacity-30: 0.3;
    --opacity-40: 0.4;
    --opacity-50: 0.5;
    --opacity-60: 0.6;
    --opacity-70: 0.7;
    --opacity-80: 0.8;
    --opacity-85: 0.85;
    --opacity-90: 0.9;
    --opacity-subdued-text: var(--opacity-70);

        /* ======================
        EASINGS (semantic)
        ====================== */
      --ease-default: cubic-bezier(0, 0, 0.2, 1);
      --ease-out-cubic: cubic-bezier(0.33, 1, 0.68, 1);
      --ease-out-quad: cubic-bezier(0.32, 0.72, 0, 1);
      --ease-in-out-quad: cubic-bezier(0.455, 0.03, 0.515, 0.955);
      --ease-hover: cubic-bezier(0.25, 0.46, 0.45, 0.94);
      --ease-active: cubic-bezier(0.5, 0, 0.75, 0);
      --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
      --ease-fade: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-slide: cubic-bezier(0.4, 0, 0.2, 1);
      --ease-smooth: cubic-bezier(0.3, 1, 0.3, 1);
      --ease-overlay: cubic-bezier(0.7, 0, 0.2, 1);
      --animation-easing: ease-in-out;

      /* ======================
        SPEEDS / DURATIONS
        ====================== */
      --speed-instant: 0.0625s;
      --speed-fast: 0.125s;
      --speed-medium: 0.15s;
      --speed-slow: 0.2s;
      --speed-drawer: 0.2s;
      --duration-fast: 0.25s;
      --duration-medium: 0.35s;
      --duration-slow: 0.5s;
      --duration-long: 0.6s;
      --drawer-animation-speed: 0.2s;


      /* ======================
        ANIMATION VALUES (combined)
        ====================== */
      --anim-fast: var(--speed-fast) var(--ease-default);
      --anim-medium: var(--speed-medium) var(--ease-default);
      --anim-slow: var(--speed-slow) var(--ease-default);
      --anim-slide: var(--speed-medium) var(--ease-slide);
      --anim-hover: var(--speed-medium) var(--ease-hover);
      --anim-bounce: var(--speed-medium) var(--ease-bounce);
      --anim-fade-in: var(--speed-medium) var(--ease-fade);
      --anim-fade-out: var(--speed-medium) var(--ease-fade);

      /* ======================
        TRANSFORM ORIGIN
        ====================== */
      --origin-start: left;
      --origin-end: right;
      --origin-center: center;
      --origin-top: top;
      --origin-bottom: bottom;

      /* Focus */
      --focus-outline-width: 0.15rem;   /* same visual width as before */
      --focus-outline-offset: 0.2em;    /* keep relative to font size */

     
      /* ======================
        Button style
        ====================== */
         /* Button size */
        --button-height: {{ settings.button_height |  divided_by: 10.0 | append: 'rem'}};
        --button-height-mobile: {{ settings.button_height_mobile | divided_by: 10.0 | append: 'rem'}};
        --button-padding-block: {{ settings.button_padding_block | divided_by: 10.0 | append: 'rem'}};
        --button-padding-inline: {{ settings.button_padding_inline | divided_by: 10.0 | append: 'rem'}};

         /* Button Borders */
        --border-width-button-primary: {{ settings.primary_button_border_width | divided_by: 10.0 | append: 'rem'}};
        --border-width-button-secondary: {{ settings.secondary_button_border_width | divided_by: 10.0 | append: 'rem'}};

        /* Button font-family */
        --button-font-family-primary: var(--font-{{ settings.type_font_button_primary }}--family);
        --button-font-family-secondary: var(--font-{{ settings.type_font_button_secondary }}--family);

        /* Button letter spacing */
        --button-letter-spacing-primary:  {{ settings.primary_button_letter_spacing | append: 'em' }} ;
        --button-letter-spacing-secondary:  {{ settings.secondary_button_letter_spacing  | append: 'em'}} ;

        /* Button text case */
        --button-text-case-primary: {{ settings.button_text_case_primary }};
        --button-text-case-secondary: {{ settings.button_text_case_secondary }};

        --button-radius-primary: {{ settings.button_border_radius_primary | divided_by: 10.0 | append: 'rem'}};
        --button-radius-secondary: {{ settings.button_border_radius_secondary | divided_by: 10.0 | append: 'rem'}};

       

        /* ======================
        Borders 
        ====================== */
        /* Base Border */
        --border-width-base: 1px;

        /* Radius Scale */
        --radius-xs: 0.2rem;
        --radius-sm: 0.6rem;
        --radius-md: 0.8rem;
        --radius-lg: 1rem;
        --radius-round: 50%;

        /* Component Radius */
        --radius-pill: {{ settings.pills_border_radius | divided_by: 10.0 | append: 'rem'}};
        --radius-input: {{ settings.inputs_border_radius | divided_by: 10.0 | append: 'rem'}};

        /* Border Width (Component) */
        --border-width-input: {{ settings.input_border_width | divided_by: 10.0 | append: 'rem'}};
        --input-height: {{ settings.input_height | divided_by: 10.0 | append: 'rem' }};

        /* Complex Borders */
        --border-popover: {{ settings.popover_border_width }}px {{ settings.popover_border }} rgb(var(--color-border-rgb) / {{ settings.popover_border_opacity }}%);
        --border-drawer: {{ settings.drawer_border_width }}px {{ settings.drawer_border }} rgb(var(--color-border-rgb) / {{ settings.drawer_border_opacity }}%);

        /* Swatch Border */
        --swatch-border-opacity: {{ settings.variant_swatch_border_opacity }}%;
        --swatch-border-width: {{ settings.variant_swatch_border_width }}px;
        --swatch-border-style: {{ settings.variant_swatch_border_style }};

        /* Borders */
        --border-color: rgb(var(--color-border-rgb) / var(--opacity-70));
        --border-hover-color: rgb(var(--color-accent-text-rgb));
        --border-width-sm: 1px;
        --border-width-md: 2px;
        --border-width-lg: 4px;
        --border-radius-sm: 0.25rem;
        
        
      /* ======================
        Icon style
        ====================== */

      /* Icon Size */
      --icon-xs: 1.36rem;      
      --icon-sm: 2rem;        
      --icon-md: 2.2rem;      
      --icon-lg: 2.4rem;     

      /* Icon Stroke */
      --icon-stroke: {% if settings.icon_stroke == 'thin' %}1px{% elsif settings.icon_stroke == 'heavy' %}2px{% else %}1.5px{% endif %};
 

      /* ======================
        Form input style
      ====================== */
      /* Size Constraints */
      --input-min-width: 200px;
      --input-search-max-width: 650px;
      --input-textarea-min-height: 100px;
      --textareas-radius: min(6.0rem, var(--radius-lg));

      --input-padding-y: 1.6rem;
      --input-padding-x: 0.8rem;
      /* Padding Scale */
      --input-padding: var(--input-padding-y) var(--input-padding-x);

      /* Border / Shadow System */
      --input-border-width: var(--border-width-input);
      --input-ring: 0 0 0 var(--input-border-width) var(--color-input-border);
      --input-ring-focus: 0 0 0 calc(var(--input-border-width) + 0.5px) var(--color-input-border);

      /* Disabled State */
      --input-bg-disabled: rgb(var(--color-foreground-rgb) / var(--opacity-10));
      --input-border-disabled: rgb(var(--color-foreground-rgb) / var(--opacity-5));
      --input-text-disabled: rgb(var(--color-foreground-rgb) / var(--opacity-50));

      /* Checkbox */
      --checkbox-size: 2.4rem;
      --checkbox-border-radius: 0.8rem;
      --checkbox-border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-30));
      --checkbox-label-padding: 0.8rem;;

      /* ======================
        Drawers style
      ====================== */
      --drawer-inline-padding: 25px;
      --drawer-menu-inline-padding: 2.5rem;
      --drawer-header-block-padding: 20px;
      --drawer-content-block-padding: 10px;
      --drawer-header-desktop-top: 0rem;
      --drawer-padding: calc(var(--spacing-2) + 7px);
      --drawer-height: 100dvh;
      --drawer-width: 95vw;
      --drawer-max-width: 500px;
      
      /* ======================
        Variant Picker Swatches style
      ====================== */
   
      --variant-picker-swatch-width-unitless: {{ settings.variant_swatch_width }};
      --variant-picker-swatch-height-unitless: {{ settings.variant_swatch_height }};
      --variant-picker-swatch-width: {{ settings.variant_swatch_width | append: 'px' }};
      --variant-picker-swatch-height: {{ settings.variant_swatch_height | append: 'px' }};
      --variant-picker-swatch-radius: {{ settings.variant_swatch_radius | append: 'px' }};
      --variant-picker-border-width: {{ settings.variant_swatch_border_width | append: 'px' }};
      --variant-picker-border-style: {{ settings.variant_swatch_border_style }};
      --variant-picker-border-opacity: {{ settings.variant_swatch_border_opacity | append: '%' }};

      /* Variant Picker Buttons */
      --variant-picker-button-radius: {{ settings.variant_button_radius | append: 'px' }};
      --variant-picker-button-border-width: {{ settings.variant_button_border_width | append: 'px' }};

      /* Slideshow */
      --slideshow-controls-size: 3.5rem;
      --slideshow-controls-icon: 2rem;
      --peek-next-slide-size: 3rem;

 
      /* ======================
        Utilities style
      ====================== */

      --backdrop-opacity: 0.15;
      --backdrop-color-rgb: var(--color-shadow-rgb);
      --minimum-touch-target: 44px;
      --disabled-opacity: 0.5;
      --skeleton-opacity: 0.025;

       /* ======================
        Modal style
      ====================== */
 
      --modal-max-height: 65dvh;
      --quick-add-modal-height: min(38.5rem, 96vh);
      --quick-add-modal-width: min(54rem, 96vw);
      --quick-add-modal-gallery-width: 24rem;



      /* Card image width and height variables */
      --card-width-small: 10rem;

      /* Card styles for search */
      --card-bg-hover: rgb(var(--color-foreground-rgb) / var(--opacity-5));
      --card-border-hover: rgb(var(--color-foreground-rgb) / var(--opacity-30));
      --card-border-focus: rgb(var(--color-foreground-rgb) / var(--opacity-10));

      /* Cart */
      --cart-primary-font-family: var(--font-body--family);
      --cart-primary-font-style: var(--font-body--style);
      --cart-primary-font-weight: var(--font-body--weight);
      --cart-secondary-font-family: var(--font-{{ settings.cart_price_font }}--family);
      --cart-secondary-font-style: var(--font-{{ settings.cart_price_font }}--style);
      --cart-secondary-font-weight: var(--font-{{ settings.cart_price_font }}--weight);
   

      /* ======================
        Badges style
      ====================== */
      --badge-blob-padding-block: 1px;
      --badge-blob-padding-inline: 12px 8px;
      --badge-rectangle-padding-block: 1px;
      --badge-rectangle-padding-inline: 6px;
      @media screen and (min-width: 750px) {
        --badge-blob-padding-block: 4px;
        --badge-blob-padding-inline: 16px 12px;
        --badge-rectangle-padding-block: 4px;
        --badge-rectangle-padding-inline: 10px;
      }

  }




  html.lenis,
  html.lenis body {
    height: auto;
  }

  .lenis:not(.lenis-autoToggle).lenis-stopped {
    overflow: clip;
  }

  .lenis [data-lenis-prevent],
  .lenis [data-lenis-prevent-wheel],
  .lenis [data-lenis-prevent-touch] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-smooth iframe {
    pointer-events: none;
  }

  .lenis.lenis-autoToggle {
    transition-property: overflow;
    transition-duration: 1ms;
    transition-behavior: allow-discrete;
  }
{% endstyle %}
