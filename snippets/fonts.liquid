 
{% # theme-check-disable %}
{%- comment -%} Initialize preloaded_fonts as an array {%- endcomment -%}
{%- assign preloaded_fonts = preloaded_fonts | default: '' | split: ',' -%}

{%- comment -%} ===== Body Font ===== {%- endcomment -%}
{%- unless settings.type_body_font.system? -%}
  <link
    rel="preload"
    as="font"
    href="{{ settings.type_body_font | font_url }}"
    type="font/woff2"
    crossorigin="anonymous"
    fetchpriority="high"
  >
{%- endunless -%}

